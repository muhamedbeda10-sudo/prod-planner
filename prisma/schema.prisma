// Production Planning & Tracking — data model
// Mirrors the Excel workbook sheets (Plans, Plan Orders, Daily Handover, Lists).
// Business values (BOM, item, dept) are English; UI is Arabic RTL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime (pooled on Supabase/Vercel)
  directUrl = env("DIRECT_URL") // migrations (direct connection)
}

// Weekly plan header. startDate is ALWAYS entered by the user, never trusted
// from the imported file (Planning copies stale dates between sheets).
model Plan {
  planNo    Int      @id
  startDate DateTime // real oven-week start date (day 0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    PlanOrder[]
  schedules PlanSchedule[]
}

// One row per MO x item (Plan Orders sheet, cols A:J).
// requiredQty = full order size; targetQty = what to make THIS week
// (balance carried in + this week's grid); plannerBalance = remark-declared balance.
model PlanOrder {
  id             Int     @id @default(autoincrement())
  planNo         Int
  bom            String
  soi            String?
  mo             String
  description    String?
  item           String // CF | TC | TN | CB
  requiredQty    Float   @default(0)
  plannerBalance Float? // parsed from REMARK "...BALANCE..."; null if no balance remark
  targetQty      Float   @default(0)
  remark         String?

  plan Plan @relation(fields: [planNo], references: [planNo], onDelete: Cascade)

  @@unique([planNo, mo, item])
  @@index([planNo])
  @@index([bom])
}

// Flat schedule (Plans sheet, cols A:H). One row per BOM/MO x item x oven date.
// ovenDate is the OVEN loading date; process due date = ovenDate - lead days.
model PlanSchedule {
  id          Int      @id @default(autoincrement())
  planNo      Int
  bom         String
  soi         String?
  mo          String
  description String?
  item        String // CF | TC | TN | CB
  ovenDate    DateTime
  qty         Float    @default(0)

  plan Plan @relation(fields: [planNo], references: [planNo], onDelete: Cascade)

  @@index([planNo])
  @@index([bom])
  @@index([ovenDate])
}

// Shop-floor handover log (Daily Handover sheet, cols A:F).
// "Done" everywhere = Welding output. Cut gates Welding.
// Rows are IMMUTABLE once written for reallocation purposes; edits are audited.
model HandoverEntry {
  id     Int      @id @default(autoincrement())
  date   DateTime // work date (day-only granularity)
  dept   String // Cut | Welding
  bom    String // raw as entered (may be auto-corrected at entry time)
  bomRaw String? // original text before normalization, if corrected
  mo     String? // manufacturing order, when recorded per-MO (execution sheet)
  item   String // CF | TC | TN | CB
  qty    Float
  planNo Int

  // The machine the pieces were finished on, when the record came off a
  // machine card — nothing else can say it. It is what lets the app MEASURE
  // how long an item really takes on a machine, against the hours the shift
  // log put on it, instead of only holding the figure somebody typed.
  machineId Int?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  // audit
  source    String   @default("manual") // manual | import | seed | reallocation
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([planNo])
  @@index([date])
  @@index([bom])
  @@index([dept])
  // the chain check, the tracker's totals and the trace all read one order's
  // item at one stage
  @@index([mo, item, dept])
  @@index([machineId])
}

// Explicit, reviewable excess-reallocation transaction (replaces the VBA's
// silent edit of the handover log). Raw HandoverEntry rows stay immutable;
// approved moves are applied as a derived adjustment layer.
// Master order registry — fed by the MONTHLY plan. Import upserts by MO:
// existing MOs are left untouched, new MOs are added. This is the general
// orders list; weekly plans only contribute delivery schedules.
model MasterOrder {
  id               Int       @id @default(autoincrement())
  mo               String    @unique
  // Which of the plant's two products this order is — a transformer (TR) or
  // an LV panel (LV). Stamped by the plan import it came from and never
  // inferred from the order's shape. Every screen shows ONE line at a time.
  line             String    @default("TR")
  soi              String?
  urgent           Boolean   @default(false)
  customer         String?
  fgCode           String?
  bom              String
  kva              String?
  rating           String?
  secItem          String?
  // The LV plan's own columns. `product` is the panel type (LSS / USS);
  // `ospEncloser` the enclosures bought outside rather than made here;
  // `materialsRemarks` the sheet's second remarks column, about parts.
  product          String?
  ospEncloser      Float     @default(0)
  materialsRemarks String?
  // Which of the line's plans brought the order: "" the line's main plan
  // (transformers / LV panels), "MB" the LV meter boxes' own sheet. A plan's
  // import revises and takes off the month only the orders of its own plan.
  family           String    @default("")
  planQty          Float     @default(0)
  // A plan import that brings a DIFFERENT qty for an order already in the
  // registry never overwrites planQty: the sheet's figure waits here, with the
  // plan that brought it, until the planner uses it or keeps the old one.
  pendingPlanQty   Float?
  pendingQtyMonth  String?
  pendingQtyAt     DateTime?
  // The order's spec columns, shown on the tracker. NONE of them is imported:
  // the monthly sheet does not carry them in a form the import can trust, so
  // the planner types them on the tracker and a re-import leaves them alone.
  // Fins sits beside the components (it is one of them, welded on the tank);
  // the rest sit beside KVA.
  fins             String?
  crcSize          String? // "CRC Size" — 900, "-", …
  colorRal         String?
  sfm              String?
  remarks          String?
  source           String? // which monthly plan (month label) FIRST added it
  // EVERY monthly plan the MO appeared in (CSV of month labels) — a carried-over
  // order shows under each of its months in the tracker filter, with a badge
  months           String    @default("")
  status           String    @default("open") // open | closed
  // OSP — quantities outsourced per component (made outside, not by our depts).
  // They never appear in the dept worklists and count as covered in the tracker.
  ospCF            Float     @default(0)
  ospTC            Float     @default(0)
  ospTN            Float     @default(0)
  ospCB            Float     @default(0)
  // Components this order does NOT need at all (CSV of CF/TC/TN/CB). The plan
  // sheets can't express this — it is set manually on the tracker.
  excludedItems    String?
  // Components this order needs although the KVA/rating rule says otherwise
  // (CSV, in practice AR/MB). The planner's own say over the rule: together
  // with excludedItems, the six components are his to switch on or off.
  includedItems    String?
  // Marked IMPORTANT by the admin: shows in a dedicated priority table on top
  // of every dept worklist until its work is done.
  priority         Boolean   @default(false)
  // ON HOLD — the planner paused this order: it stays open on the tracker
  // (tinted, with the reason) but leaves every worklist queue and the ETA
  // until released. `holdAt` set = on hold.
  holdAt           DateTime?
  holdNote         String?
  holdBy           String?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([bom])
  @@index([status])
  @@index([line])
}

// Admin date override on a fabrication-worklist line (BOM × MO × item).
// origISO is the line's ORIGINAL promised delivery date ("" = the line had no
// date — a date-less row scheduled by the admin). A date-less line may carry
// SEVERAL rows (one per chosen date), each with a QTY taken from the open
// pool; qty null = the whole line (legacy / dated-row moves). baseDone
// snapshots the dept output at scheduling time so LATER output consumes the
// admin's tranches earliest-first without double-counting what was already
// done. Reverting = deleting the row: the plan's own date (or the pool)
// resurfaces. If a weekly re-import changes the line's dates, the override no
// longer matches its origISO and silently stops applying.
model WorklistDateOverride {
  id        Int      @id @default(autoincrement())
  bom       String
  mo        String
  item      String // CF | TC | TN | CB
  origISO   String   @default("") // original delivery ISO date; "" = was date-less
  newDate   DateTime // admin-chosen delivery (oven) date
  qty       Float? // pieces scheduled on that date (null = the whole line)
  baseDone  Float    @default(0) // dept output when scheduled — consumption baseline
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // one row per (line, original date, chosen date); dated-row moves keep a
  // single row per original tranche via delete-then-create in the action
  @@unique([bom, mo, item, origISO, newDate])
}

// A worklist line the ADMIN removed from view (any dept's worklist). The line
// itself (plans, logs, registry) is untouched — restoring = deleting this row.
model WorklistLineHide {
  id        Int      @id @default(autoincrement())
  dept      String // Cut | Welding | Painting
  bom       String
  mo        String // "" for BOM-level queue lines
  item      String // CF | TC | TN | CB
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([dept, bom, mo, item])
}

// An order sent DOWN from the Plan Tracker to a dept's worklist with a chosen
// quantity per item (≤ the order's unfinished remainder), to be scheduled and
// worked there. Admin-managed; removing the row takes the line off the list.
model WorklistPush {
  id        Int      @id @default(autoincrement())
  dept      String // Cut | Welding | Painting
  bom       String
  mo        String
  item      String // CF | TC | TN | CB
  qty       Float
  baseDone  Float    @default(0) // dept output when pushed — output recorded after consumes the push
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dept, mo, item])
}

// Factory calendar — non-working days besides Fridays (public holidays,
// planned shutdowns). These days carry no production target.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique // day-only granularity
  name      String
  createdAt DateTime @default(now())
}

// A piece sent back UPSTREAM: e.g. Welding discovers a "finished" cut piece is
// incomplete and returns it to Cut. The quantity is deducted from the upstream
// department's ledger via a linked negative HandoverEntry (source "return"),
// and the row stays in the upstream dept's Returns table until re-delivered.
model ReturnEntry {
  id         Int      @id @default(autoincrement())
  date       DateTime
  fromDept   String // who returned it (Welding | Painting)
  toDept     String // who gets it back (Cut | Welding)
  bom        String
  mo         String?
  item       String // CF | TC | TN | CB
  qty        Float
  reason     String
  status     String   @default("open") // open | resolved (re-delivered)
  handoverId Int? // the linked negative ledger entry
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([toDept, status])
}

// Shop-floor note on a queue line (welding/painting worklists): free text +
// photos documenting the real state of an order — missing parts, defects,
// disputed "done" claims. Photos live under public/uploads/notes.
model QueueNote {
  id        Int      @id @default(autoincrement())
  bom       String
  mo        String? // null for BOM-level legacy lines
  item      String // CF | TC | TN | CB
  dept      String // Welding | Painting — where the note was raised
  text      String
  photos    String? // JSON array of public URL paths
  status    String   @default("open") // open | resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bom, mo, item])
  @@index([status])
}

// Application account. Admin manages accounts and assigns granular permission
// keys (see lib/domain/permissions.ts) from the in-app Users page.
model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique // login identifier (their Gmail)
  name             String
  passwordHash     String // scrypt: salt:hash hex
  isAdmin          Boolean            @default(false) // full access to the app's tools
  // The one account that owns the app: every right, and the only one that
  // sees and manages Users & Permissions — admins included.
  isOwner          Boolean            @default(false)
  perms            String             @default("") // CSV of permission keys
  // The screens this account does NOT see (CSV of tab ids — lib/domain/tabs.ts).
  // Empty sees everything; the owner sets it per person, admins included.
  hiddenTabs       String             @default("")
  // The person's own photo, in the bar's round button — a Vercel Blob URL,
  // or /uploads/avatars/<file> where there is no Blob store. Null = initials.
  avatarUrl        String?
  active           Boolean            @default(true) // deactivated users cannot log in
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sessions         Session[]
  sentMessages     ChatMessage[]      @relation("sentMessages")
  receivedMessages ChatMessage[]      @relation("receivedMessages")
  chatGroups       ChatGroupMember[]
  consumableIssues ConsumableIssue[]
  powderScraps     PowderScrap[]
  prefs            UserPref[]
  aiAccess         AiAccess?
  aiConversations  AiConversation[]
  aiUsage          AiUsage[]
  aiActions        AiAction[]
  aiInbox          AiInboxItem[]
  aiInboxSent      AiInboxItem[]      @relation("inboxSent")
  pushDevices      PushSubscription[]
  automations      Automation[]
  aiFiles          AiFile[]
  tasksCreated     Task[]             @relation("tasksCreated")
  taskAssignments  TaskAssignee[]
  taskUpdates      TaskUpdate[]
}

// A person's own view settings — the Plan Tracker's columns, folded and
// hidden components — kept on the account, so they follow them to any
// computer and two people sharing one each keep their own. One row per
// setting; the value is the setting's own short text (see lib/domain/userPrefs.ts).
model UserPref {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String
  value     String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Chat message (the in-app chat) — either a DIRECT message (toId set) or a
// GROUP message (groupId set), never both. Delivery is DB-first: the row is
// the source of truth, Supabase Realtime broadcast (when configured) only
// makes it arrive without a refresh. readAt doubles as the DM unread flag;
// group read state lives on ChatGroupMember.lastReadId.
model ChatMessage {
  id            Int       @id @default(autoincrement())
  fromId        Int
  toId          Int? // direct recipient — null for group messages
  groupId       Int? // group — null for direct messages
  body          String
  mo            String? // attached order reference — renders as a chip opening /trace
  attachments   String? // JSON array of {url,name,size,type} (images / PDF / Office)
  // "delete for me" on a DIRECT message: each end can hide it from their OWN
  // view; the row stays because the other end still sees it. Group messages
  // use ChatMessageHide (one row per hiding member) instead.
  hiddenForFrom Boolean   @default(false)
  hiddenForTo   Boolean   @default(false)
  // pinned to the top of its conversation (DM or group), by either side
  pinnedAt      DateTime?
  pinnedBy      Int?
  // reply-to (quote): points at an earlier message in the SAME conversation
  replyToId     Int?
  readAt        DateTime? // null = the DM recipient hasn't opened the thread yet
  createdAt     DateTime  @default(now())

  from  User       @relation("sentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  to    User?      @relation("receivedMessages", fields: [toId], references: [id], onDelete: Cascade)
  group ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  replyTo ChatMessage?  @relation("replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("replies")

  hides     ChatMessageHide[]
  reactions ChatReaction[]

  // thread fetch (both directions), the nav's unread count, group threads
  @@index([fromId, toId, id])
  @@index([toId, readAt])
  @@index([groupId, id])
  @@index([replyToId])
}

// A chat group: any user can create one and picks its members. The creator
// manages membership; anyone can leave. Deleting the group cascades its
// messages away.
model ChatGroup {
  id        Int      @id @default(autoincrement())
  name      String
  createdBy Int
  createdAt DateTime @default(now())

  members  ChatGroupMember[]
  messages ChatMessage[]
}

// One user's seat in a group. lastReadId is their group read cursor — every
// message with a higher id (from someone else) counts as unread.
model ChatGroupMember {
  id         Int      @id @default(autoincrement())
  groupId    Int
  userId     Int
  lastReadId Int      @default(0)
  joinedAt   DateTime @default(now())

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// "Delete for me" on a GROUP message — one row per member who hid it.
model ChatMessageHide {
  id        Int @id @default(autoincrement())
  messageId Int
  userId    Int

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// An emoji reaction on a message — one per user per message (tapping a
// different emoji replaces it, tapping the same one removes it).
model ChatReaction {
  id        Int    @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

// DB-backed session: id is the sha256 of the cookie token, so a DB leak never
// exposes usable tokens, and the admin can revoke access instantly.
model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A failed sign-in, kept a day: the login waits after too many in a short
// time for one account from one address, or from one address for any
// (lib/domain/loginThrottle.ts). Private — closed to the assistant.
model LoginFailure {
  id    Int      @id @default(autoincrement())
  email String
  ip    String
  at    DateTime @default(now())

  @@index([email, ip, at])
  @@index([ip, at])
  @@index([at])
}

// Global settings (Lists!J2:J5). Single row (id = 1).
model Settings {
  id              Int @id @default(1)
  leadCut         Int @default(4)
  leadWeld        Int @default(1)
  capacityPerItem Int @default(27)
  dailyTarget     Int @default(27)

  // Master switch for tracking tanks PIECE BY PIECE — serials, the leak-test
  // stage, painting by selection and the barcode tab. OFF by default: the
  // plant records tanks as quantities, exactly as it always did, until someone
  // decides the shop floor is ready to work off the serials. Turning it off
  // again is always safe — the tanks already recorded stay in the database and
  // pick up where they left off when it comes back on.
  tankTracking Boolean @default(false)

  // Master switch for planning work onto MACHINES: the machine board and the
  // Machine column on the worklists, the machine sheets, and the Floor view.
  // OFF until the plant plans by machine — the assignments already made stay
  // saved and come back when it is turned on.
  machinePlanning Boolean @default(false)

  // The plant's two shifts and the overtime the "+OT" button adds, in hours.
  // Editable: a roster changes (Ramadan, a second shift starting), and every
  // man-hour the app counts — the shift log, a machine's crew, the day's
  // capacity — is measured with these.
  shiftShortH Float @default(8)
  shiftLongH  Float @default(11)
  overtimeH   Float @default(3)

  // The nightly backup's own read-only login (backup_reader): when its
  // password was last made, or the login turned off, and by whom. The
  // password itself is kept nowhere but in GitHub's secret.
  backupLoginAt DateTime?
  backupLoginBy String?
}

// ---- Standard man-hours (the engineering timings sheet, editable in Admin →
// Standard Times; seeded by migration from "Final Timings 3rd industrial") ----

// Hours ONE tank of a KVA class costs each stage. The per-component split is
// derived from the sheet's engineering shares at read time (lib/domain/stdEngine).
model StdTime {
  id        Int      @id @default(autoincrement())
  kva       Int      @unique // KVA class: 100, 200, ... (admin can add classes)
  cutMh     Float // laser + bending + fin folding
  weldMh    Float
  shbMh     Float
  paintMh   Float
  updatedAt DateTime @default(now()) @updatedAt
}

// The LV panels' standard hours per UNIT and stage, from the timings sheet's LV
// tab. An order finds its row by FG code, or through its SEC item — the
// plan's FG code (FG-SUA-AS-AA-000004) is not the sheet's (FG-SUSA-8569105),
// but the SEC item 908569105 is the same panel. Steel stages only: punching /
// laser cutting, bending, welding, shot blast and the paint line; totalH is
// the sheet's whole per-unit figure, assembly and wiring included.
model LvStdTime {
  id          Int      @id @default(autoincrement())
  fg          String   @unique // as the sheet writes it: FG-SUSA-8569105
  description String?
  kind        String   @default("USS") // USS | MB (meter box) | FP (feeder pillar)
  cutH        Float
  bendH       Float
  weldH       Float
  shbH        Float
  paintH      Float
  totalH      Float?
  updatedAt   DateTime @default(now()) @updatedAt
}

// FG code → KVA class (the sheet's product table). The FG map outranks the
// order's numeric KVA — the sheet files in-between sizes inconsistently.
model StdFgMap {
  id  Int    @id @default(autoincrement())
  fg  String @unique // normalized: uppercase alphanumerics only
  kva Int
}

// Available capacity per production stage, in man-hours per WORKING DAY —
// what the plan's required hours are measured against.
model StageCapacity {
  id        Int      @id @default(autoincrement())
  dept      String   @unique // Cut | Welding | ShotBlast | Painting
  mhPerDay  Float
  updatedAt DateTime @default(now()) @updatedAt
}

// Man-hours a stage ACTUALLY worked on one day (people who showed up × their
// hours), entered by the admin. Compared against the std-hours the ledger says
// that day EARNED, it calibrates the standard times to this plant's real pace.
model DeptDayHours {
  id         Int      @id @default(autoincrement())
  date       DateTime // day-only granularity
  dept       String // Cut | Welding | ShotBlast | Painting
  hours      Float
  // The quick entry: heads present × hours each. Null on a day summed from
  // the per-worker roster.
  people     Int?
  hoursEach  Float?
  source     String   @default("roster") // roster | quick
  recordedBy String?
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([date, dept])
}

// ---- Machines and the shift log ----

// One machine (or line) of a department — a laser, a punch, the fins press,
// a paint line, a shot-blast cabinet. `center` groups the ones that do the
// same work: every laser and punch is "Cutting" (a job goes to whichever is
// free), the fins press is "Fins", a paint line is "Line". Bending has no
// machines yet — it is a stage worked by people. The admin keeps the list;
// the shift log and the worklists only read it.
model Machine {
  id          Int      @id @default(autoincrement())
  code        String   @unique // the plant's asset code: B4-10
  name        String // Bodor 3K watt
  dept        String // Cut | Welding | ShotBlast | Painting
  center      String   @default("") // Cutting | Fins | Tubes | RollBlank | Line
  hoursPerDay Float? // available hours on a working day; null = not set
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shifts     ShiftEntry[]
  downtimes  MachineDowntime[]
  lines      WorklistMachine[]
  itemTimes  MachineItemTime[]
  output     HandoverEntry[]
  manualJobs ManualJob[]
  sheetCuts  SheetCutLog[]
  rules      MachineRule[]

  @@index([dept])
}

// What one machine takes — the planner's own knowledge of the floor, written
// down so ⚡ Plan follows it: "the 6 kW laser takes 6 mm and up", "the punch
// does top covers only", "keep stainless off B4-09", "tanks of 1000 kVA and up
// go first to B4-10". `effect`:
//   only   — the machine takes ONLY work matching one of its "only" rules;
//   never  — it never takes work matching this rule;
//   prefer — among the machines allowed, it goes first for matching work.
// Every field given must match; a rule with none matches all work. Thickness
// and material are read off the line's nesting (the MATERIAL tab): a line
// matches a thickness range only when every sheet it is cut from is inside it,
// and a line with no nesting yet does not match a thickness or material rule.
// A rule taken off stays (inactive), with who took it off.
model MachineRule {
  id             Int      @id @default(autoincrement())
  machineId      Int
  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  effect         String // only | never | prefer
  item           String? // CF | TC | TN | CB | AR | MB | PNL
  line           String? // TR | LV
  minThicknessMm Float?
  maxThicknessMm Float?
  material       String? // as the MATERIAL tab names it: Steel, Stainless steel …
  minKva         Int?
  maxKva         Int?
  note           String? // the planner's own words for it
  active         Boolean  @default(true)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([machineId, active])
}

// What ONE piece of an item really costs on ONE machine, in hours — the
// planner's own figure, from the routing sheet or from watching the floor.
// Where it is set it OUTRANKS the standard-times estimate for that machine:
// its queue is priced with it, and the ⚡ planner schedules with it, so a
// 6 kW laser and a punch stop being treated as the same machine. Left empty,
// the estimate stands (the stage's standard hours split over the centres the
// item routes through).
model MachineItemTime {
  id         Int      @id @default(autoincrement())
  machineId  Int
  machine    Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  item       String // CF | TC | TN | CB | AR | MB
  hoursPerPc Float
  setBy      String?
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([machineId, item])
  @@index([machineId])
}

// One worker's day in one department, as the supervisor records it: present
// or not, which shift (day or night), overtime on the day shift, and the machine they
// were on. A worker with no row for a day is NOT SET yet — neither present nor
// absent; the Shifts tab saves a department's day only once every worker on it
// has a row (S9 day 07:00–16:00, S11 night 19:00–07:00, or absent). The
// day's man-hours per department are summed into DeptDayHours from here.
model ShiftEntry {
  id         Int      @id @default(autoincrement())
  date       DateTime // day-only granularity
  dept       String // Cut | Welding | ShotBlast | Painting
  workerId   Int
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  present    Boolean  @default(true)
  shift      String   @default("S9") // S9 | S11
  overtimeH  Float    @default(0)
  machineId  Int?
  machine    Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  // The work centre the worker was on that day, where the department has more
  // than one (Fabrication: Cutting | Bending | Fins — lib/domain/shifts.ts
  // WORK_CENTRES). The roster offers his section's centre and saves the one
  // shown; null on other departments and on rows from before centres.
  center     String?
  note       String?
  recordedBy String?
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([date, dept, workerId])
  @@index([date, dept])
  @@index([workerId])
  @@index([machineId])
}

// Hours a machine stood still on a day, and why — the planner's reason a
// day's load did not land, and the capacity a machine really had.
model MachineDowntime {
  id         Int      @id @default(autoincrement())
  date       DateTime
  machineId  Int
  machine    Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  hours      Float
  // Why, as one of the plant's codes (lib/domain/downtime.ts) so the stops can
  // be counted by cause; `reason` keeps the supervisor's own words.
  reasonCode String?
  reason     String?
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([machineId])
}

// The planner's own hours for ONE piece of an item at one work centre, for one
// KVA class — typed by hand. Where a figure is set it replaces the estimate the
// standard times split out of the stage total (lib/domain/stdEngine.ts), so
// every earned hour, load and capacity check in the app is priced with it.
model CenterStdTime {
  id         Int      @id @default(autoincrement())
  kva        Int // KVA class, as StdTime
  item       String // CF | TC | TN | CB | AR | MB
  center     String // Cutting | Bending | Fins | Welding | ShotBlast | Painting
  hoursPerPc Float
  setBy      String?
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([kva, item, center])
}

// Which machine a worklist line is on, and where it stands in that machine's
// queue — "this is running on that now". Keyed like the other worklist
// layers (dept × bom × mo × item); rank 1 is what the machine is on, the
// rest wait behind it. Recording output never touches it: a line leaves the
// board by itself once nothing remains on it.
model WorklistMachine {
  id        Int      @id @default(autoincrement())
  dept      String // Cut | Painting
  bom       String
  mo        String
  item      String
  machineId Int
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  rank      Int      @default(0)
  // Running on the machine right now — several lines can be, when the
  // machine nests or works them together; the rest wait in rank order.
  running   Boolean  @default(false)
  // Pieces of the line on THIS machine — a sheet job's sheets, to the
  // hundredth; null = whatever the other machines do not take. A line split
  // over two machines is two rows.
  qty       Float?
  // The sheet of the item this machine cuts — "<thickness>|<material>|<size>"
  // off the MATERIAL tab's nesting — when the item is spread over machines
  // by sheet (its 3 mm on one laser, its 5 mm on another, at the same time).
  // "" = the whole item, every sheet of it.
  sheet     String   @default("")
  // Pieces' worth of THAT sheet cut so far on this machine — ✓ on a sheet's
  // card line. The item itself is counted when it is recorded on the
  // worklist; that recording takes the same pieces back off this figure.
  sheetDone Int      @default(0)
  setBy     String?
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([dept, bom, mo, item, machineId, sheet])
  @@index([dept, bom, mo, item])
  @@index([machineId])
}

// One department's floor as the planner drew it on the Simulator's Floor
// canvas: where each machine (or welding partition) stands, the areas and
// labels around them — positions and sizes only, as one JSON blob
// (lib/domain/floor.ts says its shape). What each machine is ON comes from
// WorklistMachine and who stands at it from ShiftEntry, live.
model FloorLayout {
  id        Int      @id @default(autoincrement())
  dept      String   @unique // Cut | Welding | ShotBlast | Painting
  data      Json
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
}

// A named what-if scenario, saved from the Simulator ("the emergency plan for
// order X") — the knobs, the queue and the splits, as one JSON blob.
model SimScenario {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  data      Json
  savedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// The APPROVED run order — the simulator scenario the admin committed to.
// Every dept worklist shows its slice of this sequence until it is replaced
// or cleared. batchQty marks a rushed split ("first 10 of the TC").
model RunOrderEntry {
  id        Int      @id @default(autoincrement())
  rank      Int
  mo        String
  item      String
  batchQty  Float?
  batchNo   Int?
  appliedAt DateTime @default(now())
  appliedBy String?

  @@index([mo])
}

// ---- Tank serial tracking (item TN) ----
// Tanks are the first component tracked PIECE BY PIECE. HandoverEntry stays the
// ledger's truth for quantities; the rows below are the per-piece layer on top,
// so the two always agree in count. Every other component keeps working purely
// on quantities.

// A shop-floor worker: credited with a tank operation (welder, leak tester,
// painter, QA inspector) and counted on the shift log of every department.
// NOT an app account — the people on the floor rarely have logins. The admin
// keeps this list in Admin → Workers.
model Worker {
  id Int @id @default(autoincrement())

  // The number on the man's badge — what the shop floor TYPES to identify him.
  // Names on this list repeat and are long to spell; the number does not, so it
  // is the identifier everywhere and the name is only shown back to confirm it.
  empId String @unique

  name     String  @unique
  jobTitle String? // Tank Full Welder, Welder Helper, Painter, … — as HR lists it
  // The welder's STAMP: the letter he punches into every tank he welds. It is
  // physically on the steel, so it is what ties a tank in the yard back to the
  // man who made it, with or without the app.
  stamp    String?

  depts         String    @default("") // CSV of section codes (lib/domain/tanks.ts WORKER_SECTIONS)
  active        Boolean   @default(true) // inactive workers stay on old records, leave the dropdowns
  // On vacation until this day (inclusive): out of the dropdowns until then,
  // and kept absent when the shift log fills today's not-set workers in one
  // click. Null = at work.
  vacationUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shifts           ShiftEntry[]
  consumableIssues ConsumableIssue[]
  consumableShares ConsumableIssueRecipient[]

  @@index([active])
}

// ONE physical tank, born at its first welding record and carried through
// leak test → painting → the printed barcode sticker. The serial is the
// factory-visible identity the technician writes on the steel:
//   SF-<BOM>-<0001>   — the number restarts at 1 for every BOM.
// Worker names are SNAPSHOTS: renaming or deleting a worker never rewrites
// what a finished tank says about who made it.
model TankUnit {
  id     Int    @id @default(autoincrement())
  serial String @unique
  bom    String
  mo     String
  item   String @default("TN")
  seq    Int // the running number behind the serial (per BOM)
  planNo Int    @default(0)

  status String @default("welded") // welded | repair | tested | painted (lib/domain/tanks.ts)

  // The daily-log rows this tank belongs to. Without them, deleting a log row
  // would leave the tank behind — still sitting in the barcode tab claiming a
  // stage the ledger no longer records. Nullable because a row can be deleted
  // out from under a tank, and because tanks made before this link existed
  // fall back to matching by MO and status.
  weldLedgerId  Int?
  paintLedgerId Int?

  weldedAt    DateTime
  weldedById  Int?
  weldedBy    String?
  // The stamp punched into THIS tank — snapshotted at welding, like the name.
  // Re-assigning a welder's stamp later must never change what an already
  // finished tank says is on its steel.
  weldedStamp String?
  weldedLogBy String? // the app account that recorded the welding

  // leak test — the LATEST attempt; every attempt is kept in TankEvent
  testedAt   DateTime?
  testedById Int?
  testedBy   String?
  testResult String? // pass | repair
  testNote   String?

  paintedAt   DateTime?
  paintedById Int?
  paintedBy   String?

  // quality's verdict after scanning the printed barcode
  qaAt     DateTime?
  qaById   Int?
  qaBy     String?
  qaResult String? // ok | not-ok
  qaNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TankEvent[]

  @@unique([bom, seq])
  @@index([weldLedgerId])
  @@index([paintLedgerId])
  @@index([mo, status])
  @@index([status])
  @@index([bom])
}

// Every state change a tank went through — its history on the tank page, kept
// even after a later stage overwrites the summary fields above (a re-tested
// tank keeps BOTH the failed and the passing test).
model TankEvent {
  id         Int      @id @default(autoincrement())
  tankId     Int
  kind       String // welded | repaired | leak-pass | leak-repair | painted | qa-ok | qa-not-ok
  at         DateTime @default(now())
  workerId   Int?
  workerName String?
  byUser     String? // the app account that recorded it
  note       String?

  tank TankUnit @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId])
}

// Per-BOM serial counter. Bumping this row inside the SAME transaction that
// creates the tanks is what stops two technicians saving at the same moment
// from ever minting the same serial.
model TankSerialCounter {
  bom  String @id
  next Int    @default(1) // the number the NEXT tank of this BOM will take
}

// ---- MATERIAL — the planner's "Nesting Tracker" sheet, month by month ----

// One line per month × BOM × material × thickness × sheet size — the sheet's
// own row, carrying its typed columns: Quantity of Units, sheets ONE unit
// needs, and the sheets actually nested for the job. The sheet's two formula
// columns (sheets for the job, difference) are derived at read time, never
// stored, so they cannot go stale or come back as #VALUE!.
//
// producedQty is the tab's own addition: how many units were actually made
// so far. Against the sheet's actual-nesting rate it yields the sheets those
// units really consumed — the number the planner asked for.
//
// month is the plan month the sheet was imported for ("July 2026", the same
// label the monthly plan uses). It is part of the identity, so importing a
// month's sheet again updates that month's lines instead of doubling them.
model MaterialUsage {
  id                  Int      @id @default(autoincrement())
  // Which product line's nesting this is — TR or LV, stamped from the toggle
  // when the line is typed or its sheet imported. The tab shows one at a time.
  line                String   @default("TR")
  month               String   @default("") // "" = entered before months existed
  bom                 String
  mo                  String   @default("") // "" = the line covers the BOM (how the sheet writes it)
  units               Float    @default(0) // Quantity of Units
  partCode            String   @default("") // FB-022 — the part this line's sheets go into
  partName            String   @default("") // TANK, TOP COVER …
  materialCode        String   @default("") // the sheet's "Codes": T-SSS-5MM
  material            String // Steel | Stainless steel | … (lib/domain/material.ts)
  thicknessMm         Float
  sheetSize           String // "1220*2440"
  sheetsPerUnit       Float // No. of Sheets in BOM for one Unit
  // "No. of Sheets in Actual Nesting for one Unit", STORED AS THE SHEET WRITES
  // IT. It used to be derived back out of sheetsUsed ÷ units, which is a
  // round trip through a rounded product: the figure shown was never quite the
  // figure imported, and with no units on the line it vanished. Everything the
  // tab multiplies — the job, a produced quantity — multiplies THIS.
  actualPerUnit       Float?
  // The rate was TYPED in the tab rather than read off the sheet. A re-import
  // then leaves it alone: the planner types it for the lines the sheet does
  // not carry, and a fresh sheet must never blank what he worked out.
  actualPerUnitManual Boolean  @default(false)
  sheetsUsed          Float? // No. of Sheets in Actual Nesting for Job — blank until nested
  producedQty         Float? // units actually produced so far — the daily entry
  // The line's row in the sheet it came from, so the tab reads in the sheet's
  // own order rather than alphabetically. Lines typed in the tab sort last.
  sortOrder           Int      @default(0)
  // The newer sheet's own columns: the SOI it files the MO under, the weight
  // of one sheet (kg — the actual weight is that × the pieces nested for the
  // job), and the planner's average utilization of the nesting.
  soi                 String   @default("")
  // the newest sheet's first column: the MTR request the sheets were drawn on
  mtr                 String   @default("")
  weightKg            Float?
  utilization         Float?
  note                String?
  recordedBy          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([month, bom, mo, partCode, material, thicknessMm, sheetSize])
  @@index([bom])
  @@index([month])
  @@index([line])
}

// ---- ODOO close-out log (the planner's daily "22" sheet) ----

// One row per Odoo manufacturing order the office tried to close on a day,
// with what happened: "Done", or the stock error Odoo threw back. A retried
// close on a later day is a NEW row — the log records attempts, not orders,
// which is why nothing here is unique.
//
// odooMo is Odoo's own MO number (SF01/MO/…), a different series from the
// plan's MOs (PF01/MO/…), so the row stands on its own rather than linking
// to the orders registry.
model OdooEntry {
  id         Int       @id @default(autoincrement())
  // Which product line's close-out this is — TR or LV. Stamped from the
  // toggle when the row is typed or imported, from the order when it is born
  // of a closing. The tab shows one line at a time.
  line       String    @default("TR")
  date       DateTime // the day of the attempt (day-only granularity)
  soi        String?
  fgCode     String // FB-022-14003E11M11 — Odoo's finished-good code
  product    String // Tank | Top Cover | Core Frame | Encloser | Cable Box …
  odooMo     String // SF01/MO/06234
  qty        Float
  status     String    @default("MO to be close") // MO to be close | Pending | Done | Blocked | Cancelled …
  doneAt     DateTime? // when the status was moved to Done; null while it is not
  recordedBy String?
  // Where the row came from: typed (manual), the office's sheet (import), or
  // born from a closing in the ledger — a painting row (painting) or the
  // core's shot blast (shotblast). A born row carries its ledger entry's id
  // and an EMPTY odooMo: Odoo's number is not ours to know, the clerk types it.
  source     String    @default("manual")
  ledgerId   Int?      @unique
  // The FG-CODE was composed (part code + BOM) rather than copied from an
  // earlier row of the same SOI and product — worth a look before it is booked.
  fgGuessed  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  notes OdooNote[]

  @@index([date])
  @@index([doneAt])
  @@index([odooMo])
  @@index([line])
}

/// The notes on one close-out row, oldest first — what Odoo answered, what
/// was done about it. The clerk enters the row; the planner adds the notes
/// and moves the status, and can delete a note that no longer applies.
model OdooNote {
  id         Int       @id @default(autoincrement())
  entryId    Int
  entry      OdooEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  text       String
  recordedBy String?
  at         DateTime  @default(now())

  @@index([entryId])
}

// ---- CONSUMABLES — what the store hands out to the shop floor ----

// One row per hand-out: an item (typed freely — the store's own words), how
// much, the department it went to and the worker who took it. The moment is
// the server's clock at recording, never typed, so the log cannot be
// back-dated. Once written, a row is changed only by the person who recorded
// it (consumables.edit) or an admin, and every change keeps the row before
// and after in ConsumableIssueRevision, from which an admin can restore any
// earlier version. Delete is the admin's, and soft — the row leaves the log
// but stays in the table with who removed it and when.
model ConsumableIssue {
  id             Int                        @id @default(autoincrement())
  item           String
  // decimal, not float: grease by the kilo and paint by the litre must add
  // up exactly when the month is totalled
  qty            Decimal                    @db.Decimal(14, 3)
  // A worker section's code (WeldingTX, PaintingLV … — lib/domain/tanks.ts
  // WORKER_SECTIONS), or a department typed by the recorder that is not one
  // of them (Maintenance, Store …). Typed ones reappear in the dropdown.
  department     String
  // Who took it: one worker (workerId), or a group — several workers picked
  // by name, or the whole department as it stood (the workers present in the
  // section at recording). A group's people are ConsumableIssueRecipient;
  // recipientCount is how many, kept as it was that day.
  workerId       Int?
  worker         Worker?                    @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recipientScope String                     @default("worker") // worker | workers | department
  recipientCount Int                        @default(1)
  recipients     ConsumableIssueRecipient[]
  notes          String?
  issuedAt       DateTime                   @default(now())

  // The catalogue item it was handed out of; null for an item typed by hand
  // (not in the catalogue — no limit applies). `item` keeps the name either way.
  itemId          Int?
  catalog         ConsumableItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Recorded although it took a limit over (the recorder was warned and gave
  // the reason); the breach as it read at that moment, for the record.
  overLimit       Boolean         @default(false)
  overLimitReason String?
  overLimitNote   String?

  // who typed it: the account (SetNull — accounts can be deleted) and the
  // name as it was that day, so the record reads the same afterwards
  recordedById   Int?
  recordedByUser User?  @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedBy     String

  editedAt  DateTime?
  editedBy  String?
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions ConsumableIssueRevision[]

  // the log is always "not deleted, in this period"
  @@index([deletedAt, issuedAt])
  // the limit checks: one item's hand-outs in a window
  @@index([itemId, issuedAt])
  @@index([workerId])
  @@index([department])
  @@index([recordedById])
}

/// One change to a hand-out: who, when, and the row before and after — the
/// audit trail the admin reads, and the versions an admin can restore.
model ConsumableIssueRevision {
  id      Int             @id @default(autoincrement())
  issueId Int
  issue   ConsumableIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  action  String // edit | delete | restore
  // { item, qty, department, workerId, workerEmpId, workerName, notes }
  before  Json
  // the same shape after the change; null for a delete (nothing is left on
  // the log) and for revisions written before this column existed
  after   Json?
  byId    Int?
  by      String
  at      DateTime        @default(now())

  @@index([issueId])
  // the admin's Edits view: every change in a period
  @@index([at])
}

// ---- CONSUMABLES catalogue and limits ----

/// What the store hands out: the item's code and name, its unit, and the
/// limits on how much of it may go out. Never deleted once used — retired
/// items are made inactive and leave the record form.
model ConsumableItem {
  id     Int     @id @default(autoincrement())
  code   String? @unique // C-CON-DRB-04; the markers have none
  name   String  @unique
  uom    String  @default("PC")
  // the sheet's remark, kept as written ("1 month", "Qty for one person" …)
  remark String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  limits ConsumableLimit[]
  issues ConsumableIssue[]

  @@index([active])
}

/// One limit on an item: `qty` per `period` for `departments`, counted as a
/// `basis` — see lib/domain/consumableLimits.ts.
model ConsumableLimit {
  id          Int            @id @default(autoincrement())
  itemId      Int
  item        ConsumableItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // "*" = every department, else a CSV of department keys (section codes or typed departments)
  departments String
  basis       String         @default("pool") // pool | person
  period      String         @default("week") // day | week | month | quarter
  qty         Decimal        @db.Decimal(14, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
}

/// Every change to the catalogue or a limit: who, when, and the thing before
/// and after — so a limit that moved can always be traced.
model ConsumableCatalogueChange {
  id       Int      @id @default(autoincrement())
  itemId   Int
  entity   String // item | limit
  entityId Int
  action   String // create | update | delete
  before   Json?
  after    Json?
  byId     Int?
  by       String
  at       DateTime @default(now())

  @@index([itemId])
  @@index([at])
}

/// The people of a group hand-out — several workers picked by name, or the
/// whole department as it stood. Each counts an equal share of the quantity
/// against a per-person limit.
// How many workers each section had in a month — what a per-worker limit is
// multiplied by when that month is reviewed later. Rewritten (the month's
// rows replaced) whenever the workers list changes or a hand-out is
// recorded, so the last write of a month is the month as it ended; a month
// with no write reads the latest month before it. department "*" holds the
// total, so a month whose sections all went empty is still a month on record.
model ConsumableHeadcount {
  month      String // "2026-10", the factory's calendar month
  department String // a worker section's code, or "*"
  workers    Int
  updatedAt  DateTime @updatedAt

  @@id([month, department])
}

model ConsumableIssueRecipient {
  issueId  Int
  issue    ConsumableIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workerId Int
  worker   Worker          @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@id([issueId, workerId])
  @@index([workerId])
}

/// POWDER SCRAP — the powder-coating powder the painting lines throw away
/// (overspray that is not reclaimed, contaminated or expired powder), weighed
/// in kg and recorded per painting section and day. The month's scrap is set
/// against the powder the store handed out to that section (the consumables
/// hand-outs of catalogue items named "…Powder…") — the scrap rate. Soft
/// delete, every change kept in PowderScrapRevision.
model PowderScrap {
  id             Int       @id @default(autoincrement())
  /// The factory day the scrap was weighed (chosen — it is often weighed after the shift).
  day            DateTime  @db.Date
  department     String // PaintingTX | PaintingLV
  kg             Decimal   @db.Decimal(12, 3)
  notes          String?
  recordedById   Int?
  recordedByUser User?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedBy     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  editedAt       DateTime?
  editedBy       String?
  deletedAt      DateTime?
  deletedBy      String?

  revisions PowderScrapRevision[]

  @@index([deletedAt, day])
}

model PowderScrapRevision {
  id      Int         @id @default(autoincrement())
  scrapId Int
  scrap   PowderScrap @relation(fields: [scrapId], references: [id], onDelete: Cascade)
  action  String // edit | delete | restore
  before  Json
  after   Json?
  byId    Int?
  by      String
  at      DateTime    @default(now())

  @@index([scrapId])
  @@index([at])
}

// PHYSICAL MATERIAL — the store's count against SF01's stock in Odoo, one
// row per Odoo product code. One living table: importing the store's sheet
// again updates each code's row, never doubles it (lib/domain/physicalStock.ts).
model PhysicalStock {
  id        Int      @id @default(autoincrement())
  code      String   @unique // Odoo's product code, as the sheet writes it
  name      String   @default("")
  uom       String   @default("") // PC | KG …
  physical  Float    @default(0) // counted in the internal store
  odoo      Float    @default(0) // SF01's stock in Odoo
  sortOrder Int      @default(0) // the sheet's own row order
  note      String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A job put on a machine that the plan does not carry — a repair, a sample,
// a spare part, anything the floor is asked for outside the monthly plan.
// Typed on the machine board, it queues on its machine like any plan line
// (on the board as BOM "MANUAL", MO "MANUAL-<id>", item "JOB" — the key the
// machine queue rows carry), and is KEPT: done or not, the list stays to come
// back to. Its output is recorded here, never in the plan's ledger — it is
// no order's work.
//
// On the fabrication board a job is a SHEET JOB (bySheet): sheets of one
// thickness, material and size, carrying the parts of several projects
// (ManualJobPart). Its qty and doneQty then count SHEETS — the machines
// close it sheet by sheet — and the parts are what the technician cuts from
// them, never recorded in the plan's ledger by it.
model ManualJob {
  id          Int             @id @default(autoincrement())
  dept        String // Cut | Welding | Painting | ShotBlast — the board it was typed on
  title       String // what it is, in the planner's words ("" on a sheet job: its sheet names it)
  bom         String          @default("") // a BOM it belongs to, when there is one
  item        String          @default("") // the part, when there is one (Tank, bracket…)
  // pieces wanted and done — or, on a sheet job, sheets wanted and cut,
  // to the hundredth of a sheet (2.5); pieces stay whole
  qty         Float
  doneQty     Float           @default(0)
  bySheet     Boolean         @default(false)
  parts       ManualJobPart[]
  // the sheet it is cut from, typed with it — the same facts the nesting
  // gives a plan line: thickness, material, sheet size, sheets for the job
  material    String    @default("")
  thicknessMm Float?
  sheetSize   String    @default("")
  sheets      Float?
  note        String?
  // the machine it was last put on — kept when it comes off, for the record
  machineId   Int?
  machine     Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  createdBy   String?
  createdAt   DateTime  @default(now())
  doneAt      DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([dept])
  @@index([machineId])
}

// One project's part on a sheet job's sheets: the project (BOM), its
// component (TN, TC, CF …), the part in the planner's words (Bottom, Side
// wall, Skirt base …) and how many pieces the job's sheets carry of it —
// null when the planner did not give the count.
model ManualJobPart {
  id    Int       @id @default(autoincrement())
  jobId Int
  job   ManualJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bom   String    @default("")
  item  String    @default("")
  part  String
  pcs   Int?

  @@index([jobId])
  @@index([bom])
}

// Every ✓ on a sheet's line on a machine card: which sheet (thickness,
// material, size) of which item was cut on which machine, how many pieces'
// worth, and when. The board's own figure (WorklistMachine.sheetDone) is
// taken back off once the item is recorded; this log keeps it — the history
// of what each machine cuts at what thickness, for planning machines from it.
// A sheet job's ✓ writes here too — under its board key (BOM "MANUAL", MO
// "MANUAL-<id>", item "JOB"), qty = the SHEETS cut on that machine (2.5).
model SheetCutLog {
  id          Int      @id @default(autoincrement())
  at          DateTime @default(now())
  date        DateTime // the factory day it was cut on
  dept        String
  bom         String
  mo          String
  item        String
  sheet       String // "<thickness>|<material>|<size>"
  thicknessMm Float?
  machineId   Int?
  machine     Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  qty         Float
  createdBy   String?

  @@index([machineId])
  @@index([item])
  @@index([date])
}

// A NEST RUN — sheets of one material, thickness and size put on a cutting
// machine, the nesting on them carrying parts of SEVERAL jobs at once (the
// tank of one order beside the top cover of another, all 3 mm). On the
// board it queues like any line (BOM "RUN", MO "RUN-<id>", item "SHEET" —
// the key its machine-queue row carries); the technician records it by the
// sheets finished, and each part's pieces follow pro rata.
// No longer made: the fabrication board's sheet jobs (ManualJob, bySheet)
// took their place. The rows stay as the record of what was cut.
model NestRun {
  id           Int           @id @default(autoincrement())
  dept         String        @default("Cut")
  material     String
  thicknessMm  Float
  sheetSize    String        @default("")
  sheets       Int
  sheetsDone   Int           @default(0)
  // The cutting time, in minutes: identical sheets carry ONE figure (a sheet's
  // time, the run's being that × sheets); different sheets carry one per
  // sheet, in the order they are cut. Empty = not given (the parts' standard
  // times stand in).
  identical    Boolean       @default(true)
  sheetMinutes Float[]       @default([])
  note         String?
  createdBy    String?
  createdAt    DateTime      @default(now())
  doneAt       DateTime?
  updatedAt    DateTime      @updatedAt
  parts        NestRunPart[]

  @@index([dept])
}

// One job's part inside a nest run: how many pieces of it the run's sheets
// carry, how many are cut so far (from the sheets finished), and how many of
// those the item's Cut record has already counted.
model NestRunPart {
  id          Int     @id @default(autoincrement())
  runId       Int
  run         NestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  bom         String
  mo          String
  item        String
  pcs         Int
  donePcs     Int     @default(0)
  consumedPcs Int     @default(0)
  // A part cut from a sheet its nesting does not use — a 4 mm instead of its
  // 3 mm: the item's sheet this one stands in for ("<thk>|<material>|<size>"),
  // so the item counts as cut on it. "" = the run's own sheet is the item's.
  replaces    String  @default("")

  @@index([runId])
  @@index([bom, mo, item])
}

// ---- The AI assistant (the AI tab): Claude answering from this database ----
//
// It reads the database through its own Postgres login, ai_reader, which can
// only SELECT — and not from the accounts, sessions, chat, preferences or the
// assistant's own tables (see the ai_assistant migration). A table added
// later is readable by it automatically; one holding anything private must be
// revoked from ai_reader in the migration that creates it.

// The assistant's settings — one row (id = 1), the owner's alone: the Claude
// API key, the switch that opens it to the team, the model, and the plant's
// monthly spend cap.
model AiSettings {
  id                Int       @id @default(1)
  // On for the people the owner ticked; the owner can use it either way.
  enabled           Boolean   @default(false)
  // The Claude API key, AES-256-GCM encrypted (lib/server/ai/secret.ts) —
  // never sent to a browser; the hint is its last four characters.
  apiKeyEnc         String    @default("")
  apiKeyHint        String    @default("")
  // The chat's model and effort (low … max — how hard it thinks; lib/domain/ai AI_EFFORTS).
  model             String    @default("claude-opus-5-5")
  effort            String    @default("medium")
  // The automations' and the morning review's own model and effort.
  autoModel         String    @default("claude-opus-5-5")
  autoEffort        String    @default("medium")
  // The plant's spend cap for a calendar month, in US dollars (0 = none).
  monthlyUsd        Float     @default(0)
  // …and for a factory day (Cairo), in US dollars (0 = none).
  dailyUsd          Float     @default(0)
  // Model calls one question (or one automation run) may take.
  maxCalls          Int       @default(14)
  // When automations may run at all, on the factory clock: between autoFrom
  // and autoTo ("HH:MM"; both null = any time; from > to runs over midnight),
  // on these weekdays (0 = Sunday). A schedule that falls outside is skipped;
  // a condition waits for the next check inside.
  autoFrom          String?
  autoTo            String?
  autoWeekdays      Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  // The morning review: from this time on working days, unless paused.
  reviewAt          String    @default("07:30")
  reviewPaused      Boolean   @default(false)
  // ai_reader's password, made by the migration that created the login and
  // never written anywhere else.
  dbPassword        String    @default("")
  // The owner's brakes. actionsPaused: nothing the assistant prepares can
  // run — no approval goes through and nothing small runs on its own.
  // automationsPaused: no automation fires (they stay saved, and pick up
  // again when it comes off).
  actionsPaused     Boolean   @default(false)
  automationsPaused Boolean   @default(false)
  // The automations' clock: the database's own scheduler (pg_cron) calls the
  // tick endpoint every minute with a secret; its SHA-256 is kept here, the
  // secret itself only in that job. lastTickAt: the last tick that ran —
  // from that job, or from a page open somewhere when it is not set up.
  tickSecretHash    String    @default("")
  lastTickAt        DateTime?
  updatedBy         String?
  updatedAt         DateTime  @updatedAt
}

// Who besides the owner may use the assistant, and how much of the month's
// spend is theirs (0 = no cap of their own — the plant's cap still holds).
model AiAccess {
  userId     Int      @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled    Boolean  @default(true)
  monthlyUsd Float    @default(0)
  // The person's own cap for a factory day (0 = none of their own).
  dailyUsd   Float    @default(0)
  updatedAt  DateTime @updatedAt
}

// One conversation with the assistant. Its messages are kept exactly as the
// API sent and took them — tool calls, results and thinking blocks included
// — because a conversation is only ever appended to, never rewritten.
model AiConversation {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  model     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  actions   AiAction[]
  files     AiFile[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        Json // the API's content blocks
  createdAt      DateTime       @default(now())

  @@index([conversationId, id])
}

/// A file a person attached in the assistant's chat — a sheet the assistant
/// reads, and the app's own importer runs on once its import is approved.
/// The person's alone and their chat's; kept a fortnight (lib/domain/
/// aiFiles.ts), then cleared — and left out of the nightly backup.
model AiFile {
  id             Int             @id @default(autoincrement())
  userId         Int
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // the chat it was sent in — null until it goes with a question
  conversationId Int?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String
  kind           String // excel | csv | image | pdf
  type           String // the media type it is kept as
  size           Int
  // what the model counted a photo or PDF as when it was attached — how many
  // of a chat's files go again with each question; null for a sheet, or a
  // file that could not be counted then
  tokens         Int?
  sha256         String
  data           Bytes
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
}

// Every question asked and what it cost: the tokens of all the calls it took
// (one per database look-up) and their price in US dollars. What the monthly
// caps are counted against; kept when a conversation or an account is deleted.
model AiUsage {
  id               Int       @id @default(autoincrement())
  at               DateTime  @default(now())
  // kept (unnamed) when the account is deleted — the month's spend stands
  userId           Int?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId   Int?
  model            String
  question         String
  calls            Int       @default(0)
  queries          Int       @default(0)
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  costUsd          Float     @default(0)
  error            String?
  // Null while the question is being answered: one at a time per person,
  // so a burst of questions cannot run past the caps before they are counted.
  finishedAt       DateTime?

  @@index([at])
  @@index([userId, at])
}

// One change the assistant prepared — the proposal the person approves, and
// the record of what it did. It never writes on its own authority: approved,
// it runs the app's own action for the change as the person it acts for, so
// their permissions decide and the app's usual audit columns name them,
// marked "(AI)". Kept when the chat is deleted: this is the assistant's log.
model AiAction {
  id             Int             @id @default(autoincrement())
  createdAt      DateTime        @default(now())
  // the person it acts for — who approves it, whose permissions it runs with
  userId         Int
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId Int?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // the model's tool call that proposed it — places the card in the chat
  toolUseId      String?
  // or the automation that proposed it
  automationId   Int?
  automation     Automation?     @relation(fields: [automationId], references: [id], onDelete: SetNull)
  tool           String
  input          Json
  title          String
  summary        String
  // [{label, before, after}] — what the approval card shows
  changes        Json
  risk           String // low | high | destructive
  // the data the proposal was made on; approved, it runs only if the data
  // still reads the same
  snapshot       Json?
  status         String          @default("proposed") // proposed | executing | executed | failed | rejected | stale | expired | undone
  // ran without an approval click: a small change the person opted into
  auto           Boolean         @default(false)
  expiresAt      DateTime?
  decidedAt      DateTime?
  executedAt     DateTime?
  result         String?
  error          String?
  // how to put it back: {tool, input, expect} — expect is the data as the
  // change left it; the undo runs only while it still reads so
  undo           Json?
  undoOfId       Int?
  undoneAt       DateTime?
  // when the outcome was told to the assistant (at the person's next question)
  reportedAt     DateTime?

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([status, expiresAt])
  @@index([automationId])
}

// The plant's playbook for the assistant: the rules its people explained to
// it — how lines are shared out over the machines, what a morning report must
// carry, which customer goes first — kept by the admins (through the
// assistant or on the playbook page) and given to the assistant with every
// question. A rule taken off stays in the table, inactive, with its history.
model AiPlaybookEntry {
  id        Int                  @id @default(autoincrement())
  // machines | planning | reports | general — a heading, not a switch
  topic     String
  title     String
  body      String
  active    Boolean              @default(true)
  createdBy String?
  updatedBy String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  revisions AiPlaybookRevision[]

  @@index([active])
}

// Every change to a playbook rule: who, when, the rule before and after.
model AiPlaybookRevision {
  id      Int             @id @default(autoincrement())
  entryId Int
  entry   AiPlaybookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  action  String // create | update | retire | restore
  before  Json?
  after   Json?
  by      String
  at      DateTime        @default(now())

  @@index([entryId])
}

// What the assistant sends a person: a report an automation wrote, a message
// someone's automation sends them, a suggestion with its changes ready to
// approve (actionIds — the AiAction rows, the person's own to decide). The
// app's inbox (the bell) shows them; a push reaches the person's devices.
// Private, like the rest of the assistant's records.
model AiInboxItem {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // report | message | suggestion
  title        String
  body         String // Markdown, charts included
  // Whose automation it came from, as the person reads it ("Sara's automation
  // “Late welding”"); kept as text, so it reads the same after a rename.
  fromName     String?
  // who sent it by hand through the assistant (a message) — what lets them
  // take it back; null for an automation's
  fromUserId   Int?
  fromUser     User?       @relation("inboxSent", fields: [fromUserId], references: [id], onDelete: SetNull)
  automationId Int?
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  runId        Int?
  actionIds    Int[]       @default([])
  // a task's news (kind "task"): the task it is about — opening the task reads it
  taskId       Int?
  task         Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  readAt       DateTime?
  // when a push reached at least one of the person's devices
  pushedAt     DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([taskId])
}

// A piece of work one person gives others — by hand on the inbox's Tasks tab
// or through the assistant. Its people report on it (text and photos) and mark
// it done; the one who gave it approves it or returns it for rework, until it
// is done or they cancel it. Sent to several people, it is either one task
// they share (shared) or one task each, made together (batchId), each
// reported on and approved on its own. Never deleted once anyone acted on it:
// its thread is the record of who did what, when.
model Task {
  id            Int            @id @default(autoincrement())
  // the tasks made together as "one each" — the giver sees them side by side
  batchId       String?
  title         String
  details       String         @default("")
  // photos and files given with it — [{url, name, size, type}], as the chat keeps them
  attachments   Json           @default("[]")
  priority      String         @default("normal") // normal | urgent
  // the factory day it is due by
  dueDate       DateTime?      @db.Date
  // an order it is about — must be on the Orders Registry
  mo            String?
  shared        Boolean        @default(false)
  status        String         @default("open") // open | in_progress | submitted | returned | done | cancelled
  // who gave it; kept by name when the account goes
  createdById   Int?
  createdBy     User?          @relation("tasksCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String
  via           String         @default("app") // app | ai
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // the last time anything happened on it — the lists' order
  activityAt    DateTime       @default(now())
  submittedAt   DateTime?
  // done or cancelled
  closedAt      DateTime?
  // the one reminder that it passed its due day
  overdueSentAt DateTime?
  assignees     TaskAssignee[]
  updates       TaskUpdate[]
  inbox         AiInboxItem[]

  @@index([createdById, activityAt])
  @@index([status, dueDate])
  @@index([batchId])
}

// A person a task is given to.
model TaskAssignee {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// One entry of a task's thread: a note (text, photos, files), or a move —
// started, marked done, approved, returned, cancelled, reopened — with what
// was said with it. Kept by name when the account goes.
model TaskUpdate {
  id          Int      @id @default(autoincrement())
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  kind        String // note | start | submit | approve | return | cancel | reopen
  body        String   @default("")
  attachments Json     @default("[]")
  via         String   @default("app") // app | ai
  createdAt   DateTime @default(now())

  @@index([taskId, id])
}

// One device (a browser, an installed app) a person turned notifications on
// for: what the browser's push service needs to deliver to it. Gone when the
// service says the device unsubscribed, or after it keeps failing.
model PushSubscription {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())
  lastOkAt  DateTime?
  failures  Int       @default(0)

  @@index([userId])
}

// The app's Web Push identity (VAPID): a push service delivers to a device
// only what is signed with the key the device subscribed under. Made on first
// use, the private half encrypted at rest (lib/server/ai/secret.ts). Should it
// become unreadable — the secret behind it changed — a new pair is made and
// every device turns notifications on again.
model PushKeys {
  id            Int      @id @default(1)
  publicKey     String
  privateKeyEnc String
  createdAt     DateTime @default(now())
}

// What a person asked the assistant to do by itself (lib/domain/automations.ts):
// WHEN — on a schedule (times of day on the factory clock, on working days,
// every day or chosen weekdays) or when a read-only query finds rows it did
// not at its last check; WHAT — send a message, have the assistant write a
// report, or have it prepare changes that wait for the owner's approval. It
// runs as its owner, with the owner's permissions as they stand at each run,
// and stops itself after failing five times in a row. Deleting keeps it (and
// its runs) on record, off. Private: the assistant's own records.
model Automation {
  id            Int             @id @default(autoincrement())
  ownerId       Int
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  enabled       Boolean         @default(true)
  trigger       String // schedule | condition | event
  times         String[]        @default([]) // "HH:MM", Cairo
  days          String          @default("working") // working | every | weekdays
  weekdays      Int[]           @default([]) // 0 = Sunday
  conditionSql  String?
  checkEveryMin Int             @default(30)
  activeFrom    String? // "HH:MM" — a condition checked only inside these hours, on working days
  activeTo      String?
  // event: the kinds of event that fire it (lib/domain/appEvents.ts), by whom
  // (none = anyone), and words the event must carry (an MO, a department)
  eventTypes    String[]        @default([])
  eventActorIds Int[]           @default([])
  eventMatch    String?
  action        String // notify | report | act
  message       String? // notify
  prompt        String? // report | act
  recipientIds  Int[]           @default([]) // none = the owner
  // the keys the condition matched at its last check: what fires is what was not there
  lastKeys      String[]        @default([])
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  lastCheckAt   DateTime?
  lastStatus    String? // ok | failed | skipped
  lastNote      String?
  failures      Int             @default(0) // in a row
  lockedUntil   DateTime?
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  runs          AutomationRun[]
  inbox         AiInboxItem[]
  actions       AiAction[]

  @@index([enabled, nextRunAt])
  @@index([ownerId])
}

// What happened in the app, as its own actions record it once done — who did
// it, what it was about, a sentence that says it. "On event" automations fire
// from it the moment it is made; kept a few months, then cleared.
model AppEvent {
  id        Int      @id @default(autoincrement())
  type      String
  at        DateTime @default(now())
  // kept by name when the account goes
  actorId   Int?
  actorName String
  subject   String?
  summary   String
  data      Json     @default("{}")

  @@index([type, at])
  @@index([at])
}

// One time an automation fired (or failed): what caused it, what it sent and
// prepared, and what it cost. A condition checked with nothing new is not a run.
model AutomationRun {
  id           Int        @id @default(autoincrement())
  automationId Int
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  cause        String // schedule | condition | event | manual
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  status       String     @default("running") // running | ok | failed | skipped
  summary      String?
  error        String?
  costUsd      Float      @default(0)
  inboxIds     Int[]      @default([])
  actionIds    Int[]      @default([])

  @@index([automationId, startedAt])
}

// The cockpit's figures as they read on a factory day — kept so the trend of
// what cannot be recomputed later (how many plan lines were late THAT day,
// the welding coverage then) survives. One row a day, rewritten while the day
// lasts; the shape is lib/domain/kpis.ts KpiSnapshotData.
model KpiSnapshot {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  data      Json
  updatedAt DateTime @default(now()) @updatedAt
}
